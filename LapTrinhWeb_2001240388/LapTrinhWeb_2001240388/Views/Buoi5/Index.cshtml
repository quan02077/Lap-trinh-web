@using LapTrinhWeb_2001240388.Models.Buoi3_4_5;
@model List<Sach>
@{
	ViewData["Title"] = "Home Page";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="text-center mb-4" style="color: #333; font-weight: normal;">Sách Mới</h2>

<div class="row">

    @foreach (var sach in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100 border-light shadow-sm" style="border-radius: 8px;">
                <div class="card-body d-flex flex-column justify-content-between p-3">
                    <h6 class="card-title text-dark font-weight-bold text-left mb-3" style="min-height: 40px; font-size: 14px; line-height: 1.4;">
                        @sach.TenSach
                    </h6>
                    <div class="text-center my-2" style="height: 180px; display: flex; align-items: center; justify-content: center;">
                        <img src="~/hinhAnh/@sach.AnhBia" class="img-fluid" alt="@sach.TenSach" style="max-height: 100%; max-width: 100%; object-fit: contain; border-radius: 4px;" />
                    </div>
                    <div class="text-center mt-3">
                        <span class="font-weight-bold" style="color: #666; font-size: 14px;">
                            @string.Format("{0:N0}", sach.GiaBan) đ
                        </span>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
