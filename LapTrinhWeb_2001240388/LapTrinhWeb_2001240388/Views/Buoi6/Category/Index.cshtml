@model IEnumerable<LapTrinhWeb_2001240388.Models.Buoi6.Category>
@{
	Layout = "_layout_b6";
	ViewData["Title"] = "Quản lý Danh mục";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Danh sách Danh mục</h2>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Thêm mới</a>
</div>

<table class="table table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th style="width: 10%;">ID</th>
            <th>Tên danh mục</th>
            <th style="width: 20%;" class="text-center">Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.CatId</td>
                <td>@item.CatName</td>
                <td class="text-center">
                    <a asp-action="Edit" asp-route-id="@item.CatId" class="btn btn-sm btn-warning">Sửa</a>
                    <a asp-action="Delete" asp-route-id="@item.CatId" class="btn btn-sm btn-danger">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>
