@model LapTrinhWeb_2001240388.Models.Buoi6.Category
@{
    Layout = "_layout_b6";
    ViewData["Title"] = "Xóa Danh mục";
}

<h3 class="text-danger">Bạn có chắc chắn muốn xóa danh mục này?</h3>
<hr />

<div>
    <dl class="row">
        <dt class="col-sm-2">Mã danh mục:</dt>
        <dd class="col-sm-10">@Model.CatId</dd>

        <dt class="col-sm-2">Tên danh mục:</dt> 
        <dd class="col-sm-10">@Model.CatName</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" name="CatId" value="@Model.CatId" />
        <button type="submit" class="btn btn-danger">Xác nhận xóa</button>
        <a asp-action="Index" class="btn btn-secondary">Hủy</a>
    </form>
</div>